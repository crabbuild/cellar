{
  "cargo_manifest": "../../Cargo.toml",
  "package": "cellar-javascript",
  "binary": "cellar-filesystem-agent-example",
  "profile": "dev",
  "features": ["node"],
  "node_environment": {
    "root": "../../.cellar/filesystem-agent-runtime",
    "executable": "bin/node",
    "entry": "app/app.js",
    "working_directory": "app"
  },
  "primary": {
    "script_name": "filesystem-agent-example",
    "application_version": "v1",
    "cells": ["AgentSession"],
    "bindings": [{"type": "durable_object_namespace", "name": "AGENTS", "class_name": "AgentSession"}]
  }
}
