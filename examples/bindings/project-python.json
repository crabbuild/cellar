{
  "cargo_manifest": "../../Cargo.toml",
  "package": "cellar-python",
  "binary": "cellar-bindings-python",
  "profile": "dev",
  "features": [
    "embed"
  ],
  "primary": {
    "script_name": "bindings-example",
    "application_version": "v1",
    "cells": [
      "Counter",
      "OtherCounter"
    ],
    "bindings": [
      {
        "type": "durable_object_namespace",
        "name": "COUNTERS",
        "class_name": "Counter"
      },
      {
        "type": "durable_object_namespace",
        "name": "COUNTER_ALIAS",
        "class_name": "Counter"
      },
      {
        "type": "durable_object_namespace",
        "name": "OTHER_COUNTERS",
        "class_name": "OtherCounter"
      }
    ]
  }
}
