{
  "cargo_manifest": "../../Cargo.toml",
  "package": "cellar",
  "binary": "cellar-native-container",
  "profile": "dev",
  "primary": {
    "script_name": "native-container",
    "application_version": "v1",
    "cells": ["Sandbox"],
    "bindings": [{"type": "durable_object_namespace", "name": "SANDBOXES", "class_name": "Sandbox"}],
    "containers": [{"class_name": "Sandbox", "image": "Dockerfile", "instance_type": "basic"}]
  }
}
