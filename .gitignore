.DS_Store
.cellar/
.celld/
/target/
.dev.vars
node_modules/
package-lock.json
__pycache__/

# Dashboard host audit records (never commit fleet operation history).
console-audit.sqlite*

# Local embedded-Python environments
.venv/

# JS/TS executable inputs are reproduced from committed lockfiles.
/examples/javascript/app.bundle.js*
!/examples/javascript/package-lock.json
!/tools/javascript/package-lock.json
!/tools/sandbox/compat/package-lock.json
!/tools/sandbox/cloudflare-v1/package-lock.json
!/tools/rpc/package-lock.json
/tools/rpc/dist/
/examples/node/dist/
!/examples/node/package-lock.json
/examples/pi-agent/dist/
!/examples/pi-agent/package-lock.json
!/examples/filesystem-agent/package-lock.json
/examples/vercel-agent/dist/
!/examples/vercel-agent/package-lock.json
/examples/vercel-agent/ui/dist/
!/examples/vercel-agent/ui/package-lock.json
/examples/vercel-agent/ui/test-results/
/examples/vercel-agent/ui/playwright-report/

# Keep new local multi-Raft benchmark evidence out of commits.
/docs/design/multi-raft/evidence/
# Retain historical local evidence at its source-bound paths.
/plans/multi-raft/evidence/

# Reproducible streaming example builds.
/examples/streaming/app.bundle.js*
/examples/streaming/dist/
!/examples/streaming/package-lock.json

# Optional published sandbox runtime conformance bundles.
/tools/sandbox/compat/dist/
/tools/sandbox/cloudflare-v1/dist/

# Reproducible binding example builds.
/examples/bindings/app.bundle.js*
/examples/bindings/dist/
!/examples/bindings/package-lock.json
