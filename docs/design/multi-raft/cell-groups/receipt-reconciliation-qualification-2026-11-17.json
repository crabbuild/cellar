  "contract": {
    "entry": "Only originating public commands with ambiguous availability outcomes enter automatic receipt resolution. Received commands and private System/Event admissions keep their prior local contracts.",
    "ownership": "Borrow the original request and routing session. Retain its command ID, input/contract digest, fingerprint, captured inputs, namespace admission, absolute deadline and finite route tickets. No new invocation, callback, mutation submission or deadline is created.",
    "resolution": "Only a positive exact receipt completes the command. Quorum reads require actual current read authority. S3 lookup preserves required/stored minimums, physical archive verification and current output proofs. Receipt absence remains unknown.",
    "output": "Move the stored result while retaining its original SQL/archive or physical reply custody. Receipt inspection never constructs local producer authority.",
    "repair": "Use bounded same-group retry, ordinary leader discovery/backoff and scoped placement refresh. Authentication, identity, protocol and typed terminal failures are not turned into retry authority.",
    "unchanged": [
      "wire/storage format markers",
      "durability acknowledgement requirements",
      "node/peer/socket, worker and byte/item budgets",
      "original constrained benchmark topology and limits"
    ]
  },
  "regression": {
    "input": "f7780bfa9eb058f5de92a93cff14a8e092dd19832b0e21493bd07669490b7ad9",
    "positive_failure": "Both image forms independently observe the exact committed receipt, then fail because the original owner returns ambiguous Transport(StalePeer).",
    "negative_control": "A callback rollback leaves no receipt; the original identity stays ambiguous.",
    "original_changed_test_sources_reconstructed_and_hash_verified": {
      "crates/cellar/tests/native_cell_groups_execution.rs": {
