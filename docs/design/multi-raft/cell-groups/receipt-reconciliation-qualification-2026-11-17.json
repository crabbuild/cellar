  "native_cut_coverage": {
    "new_cases": [
      "post-authenticated-reply sender generation change resolves the original Quorum receipt",
      "rollback and receipt absence remain ambiguous",
      "one original route ticket cannot be replenished",
      "one caller namespace admission slot suffices for resolution",
      "held physical S3 publication, old reply invalidation and exact S3 receipt resolution"
    ],
    "images": [
      "materialized",
      "extent-backed"
    ],
    "invocation_timeout_seconds": 5,
    "ordinary_attempt_limit": 3,
    "single_ticket_control": 1,
    "single_caller_admission_control": 1,
    "callback_hold_watchdog_seconds": 15,
    "watchdog_scope": "Existing lifecycle-fixture safety watchdog; it does not extend the five-second invocation deadline.",
    "topology": "Host-native RF3 engines and real TLS ingress in one process; ingress has no local group. Native object-store tests use InMemory adapters, not the constrained RustFS backend.",
    "not_yet_qualified": [
      "physical disconnect cuts before/after append and apply",
      "automatic receipt resolution through election, member replacement and split/move",
      "automatic local receipt resolution after ownership changes",
      "pending RPC checkpoint and busy receipt-read progress",
      "independent voter failure domains"
    ]
