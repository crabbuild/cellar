    "image_publications_before": 33,
    "image_publications_after": 1,
    "oracle": "Exact final ImageState and bytes, one image-sync/rename/directory-sync sequence. No timing threshold.",
    "additional_cases": [
      "65-entry archive tails replay under 64-, 7- and 1-file destination budgets and reclaim prior batches.",
      "An incorrect intermediate digest or checksum with self-consistent successor base and valid final image fails before sealing; the original pinned image remains unchanged.",
      "Aggregate encoded/decoded/page/file budgets, empty/disconnected chains and largest intermediate disk reservation refuse before publication I/O.",
      "Growth/truncation, checksum transitions, image/directory sync failures and killed-process publication cuts retain the correct durable marker."
    ]
  },
