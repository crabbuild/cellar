  "completion": "partial",
  "scope": "Bounded private archive replay with unchanged physical identity and durability verification; local S3 acknowledgement observations.",
  "implementation": [
    "GenerationStore::prepare_chain validates aggregate file/encoded-byte/decoded-byte/page budgets before I/O and reserves twice the largest intermediate image.",
    "One exclusively owned file is physically checked at every intermediate result, including SQLite geometry, SHA-256 and optional rolling checksums. Only the final image is synced and sealed; existing single-update prepare delegates to the same path.",
    "Archive recovery partitions long histories at the destination limits, retains one bounded decoded batch plus one pending envelope, and reclaims each prior sealed batch only after its successor is sealed."
  ],
  "regression": {
    "red_source_revision": "0b3561e88ac8e7e65ce246c5cc6f047567995c98",
