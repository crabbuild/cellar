  "scope": "Resolve background-SQL command admission interference while preserving the single pending producer, global admission budgets, original deadlines, authority checks and durability proofs. No throughput or capacity qualification.",
  "environment": {
    "system": "macOS-26.5.2-arm64-arm-64bit-Mach-O",
    "validation": "Native embedded fixtures with actual SQLite/LTX, Raft-Engine, HTTP/TLS and InMemory object stores. No Colima run or cloud qualification was added for this fix."
  },
  "finding": {
    "previous_record": "evidence/MR-14-io-metrics-progress.json",
    "test": "learner_before_promotion",
    "status": "reproduced and fixed",
    "cause": "After learner abort, background SQL could occupy the cell worker while its business-command slot was empty. Admission treated physical SQL occupancy as a competing producer and returned Overloaded.",
    "reproduction": "The repeated original case failed on iteration 10 with command-after-abort context. A deterministic two-cell fixture queues an archive capture behind the other cell's held physical SQL callback and reproduces the same refusal.",
    "fix": "Allow one already-budgeted pending command to wait behind physical SQL work. Defer its initial authority/status check until SQL is idle. Existing pump logic checks cancellation/deadline before staging; a second producer still receives Overloaded."
  },
  "regressions": [
    "A queued command waits until the physical worker is released, then commits exactly once and serves the expected AtLeast read.",
    "A second command for the same group is refused while the first owns the pending slot, without another callback.",
    "An unsubmitted waiter whose deadline expires does not execute after physical worker release; a same-identity retry executes once.",
    "The original learner/abort loop passed 60 repetitions in one process; final committed membership validation also retains its unchanged promotion/abort/state assertions."
  ],
