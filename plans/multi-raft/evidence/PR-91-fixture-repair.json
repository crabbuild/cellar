  "diagnoses": [
    {
      "problem": "Quorum seed receipt overlaps archive capture before an unpolled held command.",
      "proof": "Unmodified inspection timeout and outcome diagnostic establish refusal before callback. Same20ms capture delay fails old inspection/standby call sites and passes the corrected six-case matrix. Original Linux callback-timeout logs did not print actual SDK outcomes.",
      "fix": "Four gate fixtures prepare initial state with S3 proof, preserving unpolled futures and original deadlines. Standby writes retry only Overloaded with identical IDs/input/durability and decreasing remaining timeout under one original deadline."
    },
    {
      "problem": "Lease fixture commit notification is discarded with the cancelled CAS caller while physical work can complete.",
      "proof": "Two120ms late-CAS controls explicitly record physical applied=true while original fixture times out and node continues renewing; both pass when commit observation stays with owned work. This is a controlled explanation, not an unobserved exact physical latency attributed to Linux.",
      "fix": "Keep second actual CAS, commit signal and held300ms response in a retained execution-domain task and join it before teardown. Preserve first500ms response loss,900ms lease, actual readback, full-TTL liveness and mutation assertions."
    },
    {
      "problem": "Balance fixture cuts a voter before establishing its initial published image.",
      "proof": "A controlled3s initial data delay reproduces observed=None and the original strict older-image assertion; identical delay passes with all-voter initial-image reads. Original Linux assertion did not print actual publication.",
      "fix": "Prove the seed image on all three voters before the existing data cut. Preserve strict lag, eligible leader, cooldown and catch-up assertions."
    }
  ],
